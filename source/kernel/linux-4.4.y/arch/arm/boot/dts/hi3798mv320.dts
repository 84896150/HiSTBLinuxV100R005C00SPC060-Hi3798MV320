/dts-v1/;

/ {
	compatible = "hi3798mv310-series";
	model = "Hivendor";
	interrupt-parent = <0x01>;
	#address-cells = <0x01>;
	#size-cells = <0x01>;

	reserved-memory {
		ranges;
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		phandle = <0x1f>;

		bbox-mem {
			compatible = "bbox-mem";
			no-map;
			phandle = <0x06>;
			reg = <0x5702000 0x4de000>;
		};

		bl31_log {
			no-map;
			reg = <0x5660000 0x80000>;
		};

		kdump {
			reg = <0x63dc000 0x4000>;
		};

		pmumem {
			no-map;
			reg = <0x5701000 0x1000>;
		};

		dmsg_log {
			no-map;
			reg = <0x54e0000 0x80000>;
		};

		extend_log {
			no-map;
			reg = <0x5560000 0x100000>;
		};

		mntndump {
			no-map;
			phandle = <0x07>;
			reg = <0x5700000 0x1000>;
		};

		ramoops {
			phandle = <0x20>;
			reg = <0x53e0000 0x100000>;
		};

		fastboot_log {
			no-map;
			reg = <0x56e0000 0x20000>;
		};
	};

	cpufreq_cdev_info {
		hi,cluster_num = <0x01>;
		hi,temperature_scale_capacitance = "-13169\03960\0-68\01\0605";
		hi,static_power_core_cap = "45\0-11969\01000";
		hi,hpm_param = <0xf80000b4 0x10 0xffff 0xe6 0x14a>;
		hi,ipa_cpufreq_table_index = <0x00>;
		hi,cluster_dyn_capacitance = <0x22f>;
		hi,cluster_static_capacitance = <0x8c>;
	};

	clocks {

		clk_54m {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			phandle = <0x21>;
			clock-output-names = "clk54M";
			clock-frequency = <0x337f980>;
		};

		clk_75m {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			phandle = <0x10>;
			clock-output-names = "clk75M";
			clock-frequency = <0x47868c0>;
		};

		xtal_clk {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			phandle = <0x0f>;
			clock-output-names = "clk24M";
			clock-frequency = <0x16e3600>;
		};
	};

	log_path {
		compatible = "mntn,dfx-logpath";
		dfx_ready_path = "/data/lost+found";
		dfx_root_path = "/data/";
	};

	freq_volt_check@0 {
		compatible = "huanglong,freq_volt_check";
		enable = <0x00>;
		phandle = <0x1d>;
	};

	rdr {
		bbox_area_coreid = <0x01 0x02 0x04 0x08 0x10 0x20 0x40 0x80 0x100 0x200 0x400 0x800 0x1000 0x2000 0x4000 0x8000 0x10000>;
		rdr-dumpctl = "1111111111100000";
		compatible = "mntn,rdr";
		rdr-diaginfo-size = <0x20000>;
		bbox_area_names = "AP\0CP\0TEEOS\0HIFI\0BL31\0IOM3\0ISP\0IVP\0EMMC\0MODEMAP\0CLK\0REGULATOR\0BFM\0OUTSEE\0NPU\0CONN\0EXCEPTIONTRACE";
		rdr-log-max-nums = <0x0a>;
		rdr_area_sizes = <0x00 0x00 0x40000 0x40000 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x10000 0x00 0x00 0x2000 0x00>;
		rdr-log-max-size = <0x1f400000>;
		status = "ok";
		unexpected-max-reboot-times = <0x05>;
		bbox_addr = <0x06>;
		wait-dumplog-timeout = <0x1d4c0>;
		rdr_area_num = <0x11>;
	};

	regulator_2 {
		duty_step_value = <0x01>;
		compatible = "hi,regulator";
		pwm_addr = <0xf8a23018>;
		status = "okay";
		step_num = <0xdd>;
		phandle = <0x0e>;
		volt_reg_sleep_time = <0x00>;
		regulator-min-microvolt = <0xb90f0>;
		volt_reg_type = <0x00>;
		regulator-max-microvolt = <0x124f80>;
		regulator-always-on;
		volt_reg_step = <0x00>;
		max_v_duty = <0x00>;
		regulator-name = "cpu";
	};

	sysctrl_reason {
		compatible = "mntn,sysctrl_reason";
		sysctrl_reason_offset = <0x00 0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08 0x09 0x0a 0x0b 0x0c 0x0d 0x0e 0x0f 0x10 0x11 0x12 0x13 0x14 0x15 0x16 0x17>;
		sysctrl_reason_string = "AP_S_TSENSOR0\0AP_S_TSENSOR1\0G3D_S_G3DTSENSOR\0softreset\0AP_S_AWDT\0CHARGER_S_WDT\0LPM3_S_LPMCURST\0CP_S_CPTSENSOR\0IOM3_S_IOMCURST\0ASP_S_ASPWD\0CP_S_CPWD\0CP_S_CPWD\0IVP_S_IVPWD\0ISP_S_ISPWD\0AP_S_DDR_SELFREFLASH\0AP_S_DDR_FATAL_INTER\0AP_S_DDR_FATAL_INTER\0AP_S_DDR_FATAL_INTER\0AP_S_DDR_FATAL_INTER\0AP_S_DDR_UCE_WD\0AP_S_DDR_UCE_WD\0AP_S_DDR_UCE_WD\0AP_S_DDR_UCE_WD\0OCBC_S_WD";
	};

	kdump {
		compatible = "mntn,kdump";

		reserved-dump {
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			reg = <0x53e0000 0x1000000>;
		};
	};

	opp_table@0 {
		compatible = "operating-points-v2";
		phandle = <0x0d>;
		opp-shared;

		opp@2000000000 {
			opp-microvolt = <0xf4240>;
			opp-hz = <0x00 0x77359400>;
			opp-microamp = <0xafc8>;
			clock-latency-ns = <0x493e0>;
		};

		opp@400000000 {
			opp-microvolt = <0xf4240>;
			opp-hz = <0x00 0x17d78400>;
			opp-microamp = <0x2710>;
			clock-latency-ns = <0x493e0>;
		};

		opp@1500000000 {
			opp-microvolt = <0xf4240>;
			opp-hz = <0x00 0x59682f00>;
			opp-microamp = <0xafc8>;
			clock-latency-ns = <0x493e0>;
		};

		opp@800000000 {
			opp-microvolt = <0xf4240>;
			opp-hz = <0x00 0x2faf0800>;
			opp-microamp = <0x2ee0>;
			clock-latency-ns = <0x493e0>;
		};

		opp@200000000 {
			opp-microvolt = <0xf4240>;
			opp-hz = <0x00 0xbebc200>;
			opp-microamp = <0x2710>;
			clock-latency-ns = <0x493e0>;
		};

		opp@1250000000 {
			opp-microvolt = <0xf4240>;
			opp-hz = <0x00 0x4a817c80>;
			opp-microamp = <0xafc8>;
			clock-latency-ns = <0x493e0>;
			status = "disabled";
		};

		opp@1300000000 {
			opp-microvolt = <0xf4240>;
			opp-hz = <0x00 0x4d7c6d00>;
			opp-microamp = <0xafc8>;
			clock-latency-ns = <0x493e0>;
			status = "disabled";
		};

		opp@600000000 {
			opp-microvolt = <0xf4240>;
			opp-hz = <0x00 0x23c34600>;
			opp-microamp = <0x2ee0>;
			clock-latency-ns = <0x493e0>;
		};

		opp@1000000000 {
			opp-microvolt = <0xf4240>;
			opp-hz = <0x00 0x3b9aca00>;
			opp-microamp = <0x2ee0>;
			clock-latency-ns = <0x493e0>;
		};

		opp@1650000000 {
			opp-microvolt = <0xf4240>;
			opp-hz = <0x00 0x62590080>;
			opp-microamp = <0xafc8>;
			clock-latency-ns = <0x493e0>;
		};
	};

	__symbols__ {
		tsensor = "/tsensor@0xa15a00";
		gpio2 = "/soc/amba/gpio2";
		gpu_vmodel = "/soc/gpu_vmodel";
		vddgpu = "/soc/regulator@f8a23020";
		bspdwc3 = "/soc/bspdwc3@f9890000";
		ir = "/soc/amba/ir@f8001000";
		gpio0 = "/soc/amba/gpio0";
		gpu_temperature = "/soc/gpu_temperature";
		gpu = "/soc/gpu@f9200000";
		regulator_2 = "/regulator_2";
		rsvmem = "/reserved-memory";
		clk_54m = "/clocks/clk_54m";
		cpu_opp_table = "/opp_table@0";
		gpio7 = "/soc/amba/gpio7";
		watchdog0 = "/soc/amba/watchdog@f8a2c000";
		hii2c2 = "/soc/amba/i2c@f8b12000";
		freq_volt_check = "/freq_volt_check@0";
		gic = "/interrupt-controller";
		gpio5 = "/soc/amba/gpio5";
		hivendor_clock = "/soc/hivendor_clock";
		threshold = "/thermal-zones/soc_thermal/trips/trip-point@0";
		uart2 = "/soc/amba/uart@f8b02000";
		hii2c0 = "/soc/amba/i2c@f8b10000";
		avs_compensation = "/avs@0";
		CPU2 = "/cpus/cpu@2";
		hiddr_watchzone = "/soc/hiddr_watchzone@F8A35000";
		emmc = "/soc/himciv200.MMC@f9830000";
		spi = "/soc/amba/spi@F8B1A000";
		gpio3 = "/soc/amba/gpio3";
		pcie = "/soc/pcie@0xF0000000";
		uart0 = "/soc/amba/uart@f8b00000";
		CPU0 = "/cpus/cpu@0";
		fmc = "/soc/hifmc100.NAND@f9950000";
		hdmitx = "/soc/edid";
		chiptrim = "/soc/chiptrim";
		gpio1 = "/soc/amba/gpio1";
		clk_75m = "/clocks/clk_75m";
		higmac0 = "/soc/ethernet@f9840000";
		critical = "/thermal-zones/soc_thermal/trips/trip-point@3";
		mntn_mem = "/reserved-memory/bbox-mem";
		xtal_clk = "/clocks/xtal_clk";
		hivendor_reset = "/soc/hivendor_reset";
		hivendor_iocfg = "/soc/hivendor_iocfg";
		cluster0 = "/cpus/cpu-map/cluster0";
		dvfs = "/dvfs@0";
		sdio = "/soc/hi3798mv320.SD@f9c40000";
		regulator_1 = "/regulator_1";
		power_model0 = "/soc/gpu@f9200000/power_model0";
		gpio8 = "/soc/amba/gpio8";
		hi_sensor0 = "/soc/hi-sensor@0";
		xhci_1 = "/soc/xhci@f98a0000";
		ramoops_ram = "/reserved-memory/ramoops";
		ipa_sensor0 = "/ipa-sensor@0";
		gpio6 = "/soc/amba/gpio6";
		dump_mem = "/reserved-memory/mntndump";
		uart3 = "/soc/amba/uart@f8b03000";
		hii2c1 = "/soc/amba/i2c@f8b11000";
		hiddr_watchpoint = "/soc/hiddr_watchpoint@F8A36000";
		CPU3 = "/cpus/cpu@3";
		gpio4 = "/soc/amba/gpio4";
		eth_phy0 = "/soc/ethernet@f9840000/ethernet_phy@0";
		target = "/thermal-zones/soc_thermal/trips/trip-point@1";
		hot = "/thermal-zones/soc_thermal/trips/trip-point@2";
		CPU1 = "/cpus/cpu@1";
	};

	mntnctl {
		compatible = "mntn,mntnctl";
		mntnctl = "010010111100101010111111101001100000011000001";
	};

	soc {
		compatible = "simple-bus";
		device_type = "soc";
		ranges = <0x00 0x00 0xffffffff>;
		#address-cells = <0x01>;
		#size-cells = <0x01>;

		hi3798mv320.SD@f9c40000 {
			sd-uhs-sdr25;
			compatible = "nebula,sdhci";
			clocks = <0x0c 0x2a4>;
			devid = <0x01>;
			cap-sd-highspeed;
			resets = <0x11 0x2a4 0x10 0x11 0x2a4 0x11 0x11 0x2a4 0x12 0x11 0x2a8 0x01>;
			clock-names = "mmc_clk";
			status = "okay";
			interrupts = <0x00 0x56 0x04>;
			bus-width = <0x04>;
			phandle = <0x37>;
			sd-uhs-sdr50;
			sd-uhs-sdr12;
			reg = <0xf9c40000 0x1000>;
			sd-uhs-sdr104;
			iocfg_regmap = <0x13>;
			reset-names = "crg_reset\0crg_tx\0crg_rx\0dll_reset";
			crg_regmap = <0x0c>;
			max-frequency = <0xb71b000>;
		};

		gpu_vmodel {
			compatible = "gpu,vmodel";
			phandle = <0x16>;

			vmodel@400000 {
				vmodel-hgain = <0x00>;
				vmodel-constant = <0x494>;
				vmodel-lgain = <0x32>;
				vmodel-minimum = <0x32a>;
				vmodel-ratio = <0x4c9>;
				vmodel-otp-volt = <0x28>;
			};

			vmodel@712000 {
				vmodel-hgain = <0x00>;
				vmodel-constant = <0x553>;
				vmodel-lgain = <0x1e>;
				vmodel-minimum = <0x32a>;
				vmodel-ratio = <0x677>;
				vmodel-otp-volt = <0x28>;
			};

			vmodel@300000 {
				vmodel-hgain = <0x00>;
				vmodel-constant = <0x479>;
				vmodel-lgain = <0x28>;
				vmodel-minimum = <0x32a>;
				vmodel-ratio = <0x480>;
				vmodel-otp-volt = <0x28>;
			};

			vmodel@200000 {
				vmodel-hgain = <0x00>;
				vmodel-constant = <0x479>;
				vmodel-lgain = <0x28>;
				vmodel-minimum = <0x32a>;
				vmodel-ratio = <0x480>;
				vmodel-otp-volt = <0x28>;
			};

			vmodel@540000 {
				vmodel-hgain = <0x00>;
				vmodel-constant = <0x494>;
				vmodel-lgain = <0x32>;
				vmodel-minimum = <0x32a>;
				vmodel-ratio = <0x4c9>;
				vmodel-otp-volt = <0x28>;
			};
		};

		gpu_temperature {
			h_temperature_h = <0x2d>;
			compatible = "gpu,temperature";
			phandle = <0x17>;
			l_temperature_l = <0x23>;
			h_temperature_l = <0x28>;
			l_temperature_h = <0x28>;
		};

		hi-sensor@0 {
			compatible = "arm,hi-thermal";
			#thermal-sensor-cells = <0x01>;
			phandle = <0x23>;
		};

		amba {
			compatible = "arm,amba-bus";
			ranges;
			interrupt-parent = <0x01>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;

			ir@f8001000 {
				compatible = "hivendor,hi-ir";
				clocks = <0x0c 0x384>;
				interrupts = <0x00 0x2f 0x04>;
				phandle = <0x31>;
				reg = <0xf8001000 0x1000>;
				linux,rc-map-name = "rc-hi";
			};

			gpio2 {
				compatible = "arm,pl061\0arm,primecell";
				clocks = <0x0f>;
				clock-names = "apb_pclk";
				gpio-controller;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x6e 0x04>;
				phandle = <0x26>;
				arm,primecell-periphid = <0x41061>;
				reg = <0xf8b22000 0x1000>;
				#gpio-cells = <0x02>;
				interrupt-controller;
			};

			uart@f8b02000 {
				compatible = "arm,pl011\0arm,primecell";
				clocks = <0x10>;
				clock-names = "apb_pclk";
				status = "okay";
				interrupts = <0x00 0x33 0x04>;
				phandle = <0x33>;
				arm,primecell-periphid = <0x241011>;
				reg = <0xf8b02000 0x1000>;
			};

			arm-timer {
				compatible = "arm,armv7-timer";
				interrupts = <0x01 0x0d 0xf04 0x01 0x0e 0xf04>;
				clock-frequency = <0x16e3600>;
			};

			gpio0 {
				compatible = "arm,pl061\0arm,primecell";
				clocks = <0x0f>;
				clock-names = "apb_pclk";
				gpio-controller;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x6c 0x04>;
				phandle = <0x24>;
				arm,primecell-periphid = <0x41061>;
				reg = <0xf8b20000 0x1000>;
				#gpio-cells = <0x02>;
				interrupt-controller;
			};

			spi@F8B1A000 {
				compatible = "arm,pl022\0arm,primecell";
				clocks = <0x0c 0x70>;
				clock-names = "apb_pclk";
				#address-cells = <0x01>;
				interrupts = <0x00 0x2d 0x04>;
				#size-cells = <0x00>;
				phandle = <0x30>;
				arm,primecell-periphid = <0x41022>;
				reg = <0xf8b1a000 0x1000>;
				num-cs = <0x02>;
				pl022,rt;
			};

			watchdog@f8a2c000 {
				start_ping_in_kernel = <0x01>;
				compatible = "arm,sp805-wdt\0arm,primecell";
				clocks = <0x0f>;
				clock-names = "apb_pclk";
				interrupts = <0x00 0x1d 0x04>;
				phandle = <0x2c>;
				arm,primecell-periphid = <0x141805>;
				reg = <0xf8a2c000 0x1000>;
				timeout-sec = <0x0a>;
			};

			i2c@f8b12000 {
				compatible = "hivendor,hi-i2c";
				clocks = <0x0c 0x1b4>;
				clock-names = "apb_pclk";
				#address-cells = <0x01>;
				interrupts = <0x00 0x28 0x04>;
				#size-cells = <0x00>;
				phandle = <0x2f>;
				reg = <0xf8b12000 0x1000>;
				clock-frequency = <0x61a80>;
			};

			gpio7 {
				compatible = "arm,pl061\0arm,primecell";
				clocks = <0x0f>;
				clock-names = "apb_pclk";
				gpio-controller;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x73 0x04>;
				phandle = <0x2a>;
				arm,primecell-periphid = <0x41061>;
				reg = <0xf8b27000 0x1000>;
				#gpio-cells = <0x02>;
				interrupt-controller;
			};

			gpio5 {
				compatible = "arm,pl061\0arm,primecell";
				clocks = <0x0f>;
				clock-names = "apb_pclk";
				gpio-controller;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x71 0x00>;
				phandle = <0x28>;
				arm,primecell-periphid = <0x41061>;
				reg = <0xf8004000 0x1000>;
				#gpio-cells = <0x02>;
				interrupt-controller;
			};

			timer@hisp804 {
				compatible = "hivendor,hisp804";
				clocks = <0x0f>;
				clock-names = "apb_pclk";
				interrupts = <0x00 0x1a 0x04 0x00 0x3b 0x04 0x00 0x1b 0x04 0x00 0x3c 0x04>;
				reg = <0xf8a29000 0x20 0xf8a2a000 0x20 0xf8a2a020 0x20 0xf8a2b000 0x20 0xf8a2b020 0x20>;
			};

			gpio3 {
				compatible = "arm,pl061\0arm,primecell";
				clocks = <0x0f>;
				clock-names = "apb_pclk";
				gpio-controller;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x6f 0x04>;
				phandle = <0x27>;
				arm,primecell-periphid = <0x41061>;
				reg = <0xf8b23000 0x1000>;
				#gpio-cells = <0x02>;
				interrupt-controller;
			};

			i2c@f8b11000 {
				compatible = "hivendor,hi-i2c";
				clocks = <0x0c 0x1b0>;
				clock-names = "apb_pclk";
				#address-cells = <0x01>;
				interrupts = <0x00 0x27 0x04>;
				#size-cells = <0x00>;
				phandle = <0x2e>;
				reg = <0xf8b11000 0x1000>;
				clock-frequency = <0x61a80>;
			};

			gpio1 {
				compatible = "arm,pl061\0arm,primecell";
				clocks = <0x0f>;
				clock-names = "apb_pclk";
				gpio-controller;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x6d 0x04>;
				phandle = <0x25>;
				arm,primecell-periphid = <0x41061>;
				reg = <0xf8b21000 0x1000>;
				#gpio-cells = <0x02>;
				interrupt-controller;
			};

			armv7-pmu {
				compatible = "arm,cortex-a17-pmu";
				interrupts = <0x00 0x08 0x04 0x00 0x09 0x04 0x00 0x0a 0x04 0x00 0x0b 0x04>;
			};

			uart@f8b03000 {
				compatible = "arm,pl011\0arm,primecell";
				clocks = <0x10>;
				clock-names = "apb_pclk";
				status = "okay";
				interrupts = <0x00 0x34 0x04>;
				phandle = <0x34>;
				arm,primecell-periphid = <0x241011>;
				reg = <0xf8b03000 0x1000>;
			};

			uart@f8b00000 {
				compatible = "arm,pl011\0arm,primecell";
				clocks = <0x10>;
				clock-names = "apb_pclk";
				status = "okay";
				interrupts = <0x00 0x31 0x04>;
				phandle = <0x32>;
				arm,primecell-periphid = <0x241011>;
				reg = <0xf8b00000 0x1000>;
			};

			gpio8 {
				compatible = "arm,pl061\0arm,primecell";
				clocks = <0x0f>;
				clock-names = "apb_pclk";
				gpio-controller;
				#interrupt-cells = <0x02>;
