		dvfs_anti_aging_limit_freq = <0xf4240>;
		otp_freq_200000 = <0x44c 0x00 0x0f>;
	};

	interrupt-controller {
		compatible = "arm,gic-v3";
		#interrupt-cells = <0x03>;
		#address-cells = <0x00>;
		phandle = <0x01>;
		reg = <0xf1000000 0x10000 0xf1040000 0x80000>;
		interrupt-controller;
	};

	tsensor@0xa15a00 {
		hi,tsensor_ctrl_config = <0x72>;
		compatible = "hi,tsensor";
		hi,pmc_tsensorout_offset = <0x08>;
		hi,tsensor_trimming_otp_offset = <0x1db>;
		hi,tsensor_id = <0x00>;
		hi,tsensor_name = "cpu";
		hi,tsensor_reg_offset = <0x00>;
		hi,tsensor_trimming_otp_base = <0xf8ab0000>;
		hi,tsensor_trimming_otp_enable = <0x01>;
		phandle = <0x18>;
		hi,tsensor_reg = <0xf8a23028 0x1c>;
		hi,tsensor_scale_capacitance = <0x84 0xa5 0x328 0x28>;
		hi,sensors = <0x01>;
	};
};
