		area_num = <0x01>;
		area_names = "AP";
		status = "ok";
		area_sizes = <0x200>;
	};

	dvfs@0 {
		cpu_freq_400000 = <0x505 0x432 0x37 0x32a 0x44c 0x4b0>;
		dvfs_quit_low_temp_comp_threshold = <0xff>;
		compatible = "hi,dvfs";
		otp_freq_800000 = <0x44d 0x00 0x0f>;
