		cpu_freq_1000000 = <0x61c 0x563 0x28 0x32a 0x44c 0x4b0>;
		dvfs_enter_standby_threshold = <0x78>;
		cpu_freq_200000 = <0x505 0x432 0x37 0x32a 0x44c 0x4b0>;
		dvfs_enter_limiting_freq_threshold = <0xff>;
		otp_freq_600000 = <0x44c 0x04 0x0f>;
		otp_freq_1250000 = <0x44e 0x00 0x0f>;
		otp_freq_1000000 = <0x44d 0x04 0x0f>;
		cpu_freq_1500000 = <0x6d3 0x5eb 0x28 0x32a 0x44c 0x4b0>;
		otp_compensation_enable = <0x44f 0x01>;
		cpu_freq_800000 = <0x59a 0x4ea 0x28 0x32a 0x44c 0x4b0>;
		dvfs_quit_limiting_freq_threshold = <0xff>;
		dvfs_limit_max_freq = <0x16e360>;
		cpu_freq_2000000 = <0x00 0x47e 0x00 0x32a 0x47e 0x4b0>;
		dvfs_enter_high_temp_comp_threshold = <0xff>;
		cpu_freq_1650000 = <0x00 0x47e 0x00 0x32a 0x47e 0x4b0>;
		dvfs_quit_anti_aging_threshold = <0x5f>;
		phandle = <0x1c>;
		otp_freq_1500000 = <0x44e 0x00 0x0f>;
		otp_freq_400000 = <0x44c 0x00 0x0f>;
		cpu_freq_1300000 = <0x710 0x60e 0x28 0x32a 0x44c 0x4b0>;
